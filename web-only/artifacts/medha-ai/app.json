{
  "expo": {
    "name": "Medha AI Cognitive Care",
    "slug": "medha-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medha-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Medha AI uses your location to help you return home safely.",
          "locationAlwaysAndWhenInUsePermission": "Medha AI uses your location in the background to alert your caregiver if you leave a safe zone."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
